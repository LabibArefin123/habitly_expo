{
  "expo": {
    "name": "Habitly",
    "slug": "habitly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/habitly-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FAF6",
        "foregroundImage": "./assets/images/habitly-icon.png",
        "backgroundImage": "./assets/images/habitly-icon.png",
        "monochromeImage": "./assets/images/habitly-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.labibarefn123.habitly"
    },
    "web": {
      "favicon": "./assets/images/habitly-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/habitly-icon.png",
          "imageWidth": 110,
          "resizeMode": "contain",
          "backgroundColor": "#F4FAF6"
        }
      ]
    ]
  }
}
